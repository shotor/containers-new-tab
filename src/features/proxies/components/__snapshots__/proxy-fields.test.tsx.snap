// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ProxyFields > matches snapshot 1`] = `
<div>
  <div
    class="root"
  >
    <label
      class="fullField"
      for="P0-0-name"
    >
      Name
      <input
        class="root"
        id="P0-0-name"
        required=""
      />
    </label>
    <label
      class="field"
      for="P0-0-type"
    >
      Type
      <select
        class="root"
        id="P0-0-type"
      >
        <option
          value="http"
        >
          HTTP
        </option>
        <option
          value="https"
        >
          HTTPS
        </option>
        <option
          value="socks"
        >
          SOCKS5
        </option>
        <option
          value="socks4"
        >
          SOCKS4
        </option>
      </select>
    </label>
    <label
      class="field"
      for="P0-0-host"
    >
      Host
      <input
        class="root"
        id="P0-0-host"
        required=""
      />
    </label>
    <label
      class="field"
      for="P0-0-port"
    >
      Port
      <input
        class="root"
        id="P0-0-port"
        max="65535"
        min="1"
        required=""
        step="1"
        type="number"
      />
    </label>
    <label
      class="fullField"
      for="P0-0-username"
    >
      Username (optional)
      <input
        autocomplete="off"
        class="root"
        id="P0-0-username"
        type="text"
      />
    </label>
    <label
      class="fullField"
      for="P0-0-password"
    >
      Password (optional)
      <input
        autocomplete="new-password"
        class="root"
        id="P0-0-password"
        type="password"
      />
    </label>
    <label
      class="bypass"
    >
      <input
        class="switch"
        role="switch"
        type="checkbox"
      />
      Don’t proxy localhost
    </label>
  </div>
</div>
`;
