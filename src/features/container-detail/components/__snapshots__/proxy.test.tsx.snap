// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Proxy > matches snapshot 1`] = `
<div>
  <p
    class="root warning"
    role="note"
  >
    This is separate from the proxy config in Multi-Account Containers. Other extensions can’t change MAC’s proxy settings, so anything you set here will still work, but must then be managed from here exclusively.
  </p>
  <div
    class="field"
  >
    <label
      class="root"
      for="detail-proxy-type"
    >
      Type
    </label>
    <select
      class="root"
      id="detail-proxy-type"
      name="type"
    >
      <option
        value="direct"
      >
        No proxy (direct)
      </option>
      <option
        value="http"
      >
        http
      </option>
      <option
        value="https"
      >
        https
      </option>
      <option
        value="socks"
      >
        socks
      </option>
      <option
        value="socks4"
      >
        socks4
      </option>
    </select>
  </div>
  <div
    class="field"
  >
    <label
      class="root"
      for="detail-proxy-host"
    >
      Host
    </label>
    <input
      class="root"
      id="detail-proxy-host"
      name="host"
      type="text"
    />
  </div>
  <div
    class="field"
  >
    <label
      class="root"
      for="detail-proxy-port"
    >
      Port
    </label>
    <input
      class="root"
      id="detail-proxy-port"
      max="65535"
      min="1024"
      name="port"
      type="number"
    />
  </div>
  <div
    class="field"
  >
    <label
      class="root"
      for="detail-proxy-user"
    >
      Username (optional)
    </label>
    <input
      autocomplete="off"
      class="root"
      id="detail-proxy-user"
      name="username"
      type="text"
    />
  </div>
  <div
    class="field"
  >
    <label
      class="root"
      for="detail-proxy-pass"
    >
      Password (optional)
    </label>
    <input
      autocomplete="new-password"
      class="root"
      id="detail-proxy-pass"
      name="password"
      type="password"
    />
  </div>
  <div
    class="field"
  >
    <label
      class="root"
    >
      <input
        name="doNotProxyLocal"
        type="checkbox"
      />
       Don’t proxy localhost
    </label>
  </div>
</div>
`;
