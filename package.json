{
  "name": "containers-new-tab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "New tab and homepage for Firefox Multi Account Containers - pick, sort, create, edit, and open sites in the right container with ease.",
  "scripts": {
    "────────── dev ──────────": "────────────────────────────────────────────────",
    "dev": "vite",
    "dev:watch": "vite build --watch --mode development",
    "dev:firefox": "node dev.ts",
    "start": "npx web-ext run -s dist --start-url about:newtab",
    "───────── build ─────────": "────────────────────────────────────────────────",
    "build": "tsc --noEmit && vite build",
    "package": "rm -rf dist && npm run build && web-ext build --source-dir dist --overwrite-dest --ignore-files \"virtual:*\"",
    "────────── lint ─────────": "────────────────────────────────────────────────",
    "lint": "npm run oxfmt && npm run oxide",
    "lint:fix": "npm run oxfmt:fix && npm run oxide:fix",
    "oxfmt": "oxfmt --check .",
    "oxfmt:fix": "oxfmt --write .",
    "oxide": "oxlint",
    "oxide:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "────────── test ─────────": "────────────────────────────────────────────────",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:firefox": "npm run build && node .scripts/firefox.ts",
    "──────── firefox ────────": "────────────────────────────────────────────────",
    "firefox": "node .scripts/firefox.ts --interactive",
    "────────── npm ──────────": "────────────────────────────────────────────────",
    "prepare": "husky"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/firefox-webext-browser": "143.0.0",
    "@types/node": "26.4.1",
    "@types/selenium-webdriver": "4.35.6",
    "@vitest/coverage-v8": "5.0.0",
    "concurrently": "10.0.5",
    "happy-dom": "20.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "selenium-webdriver": "4.48.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-static-copy": "4.1.1",
    "vite-plugin-web-extension": "4.5.1",
    "vitest": "5.0.0",
    "web-ext": "10.6.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "spawn-sync@1.0.15": true
  },
  "lint-staged": {
    "*": "oxfmt --check --no-error-on-unmatched-pattern",
    "*.{ts,tsx,js,jsx,mjs,cjs}": "oxlint"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "classnames": "2.5.1",
    "preact": "10.29.8",
    "react-hook-form": "7.87.0",
    "wouter": "3.11.0",
    "zod": "4.5.4"
  }
}
